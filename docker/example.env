ImmichServerUrl=URL

# Either ApiKey or ApiKeyFile must be specified.
ApiKey=KEY
# ApiKeyFile=/path/to/key

# --- Configuration storage ---
# Configuration is stored in a SQLite database so it can be edited at runtime.
# By default the database is created inside the Config directory (/app/Config/immichframe.db);
# mount /app/Config to persist it. Override the location with IMMICHFRAME_DB_PATH.
# IMMICHFRAME_DB_PATH=/app/Config/immichframe.db
#
# On first start, the values below (or a Settings.json/Settings.yml) are imported into the
# database once. After that the database is authoritative and these values are ignored.
# To force a one-time re-import after editing this file, set IMMICHFRAME_REIMPORT=true for one boot.
# IMMICHFRAME_REIMPORT=false

# --- Admin UI ---
# Browse to /admin to manage configuration in your browser. On first run you can create the admin
# account directly in the UI, or bootstrap it here (only used while no admin account exists yet):
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
#
# Exposing ImmichFrame to the internet? Set ADMIN_USERNAME/ADMIN_PASSWORD before first start
# (so the public can't reach first-run setup) and put it behind a TLS reverse proxy.
# See docker/reverse-proxy.md for Caddy/Traefik/nginx examples and a hardening checklist.

# --- Reverse proxy / client IP ---
# When running behind a reverse proxy, set IMMICHFRAME_TRUSTED_PROXIES to the proxy's own IP(s)
# and/or CIDR network(s) (comma-separated). ImmichFrame then trusts X-Forwarded-For / -Proto ONLY
# from those addresses, so the per-IP login/PIN rate limit and HTTPS-cookie detection use the real
# client IP. With Docker Compose this is usually the bridge subnet of the proxy (e.g. 172.16.0.0/12).
#   IMPORTANT: leaving this UNSET while behind a proxy makes every visitor look like the proxy, so
#   they share one rate-limit bucket (one attacker can lock everyone out) and X-Forwarded-Proto is
#   ignored. If you expose the container directly (no proxy), leave it unset — that is the safe default.
# IMMICHFRAME_TRUSTED_PROXIES=172.16.0.0/12

# --- Global content API access (IMPORTANT) ---
# By DEFAULT the global /api/* content API (the full photo library, weather, calendar) is
# OPEN to anyone who can reach the host — no login or PIN required. The per-link PIN/viewer
# gates ONLY protect /[slug] slideshow links, not the global library.
#   * To publish ONLY /[slug] links and lock the global library, set:
#         IMMICHFRAME_REQUIRE_SECRET=true
#     The global /api/* endpoints then return 401 unless an AuthenticationSecret is supplied,
#     while your /[slug] links keep working normally.
#   * Setting an AuthenticationSecret below has the same locking effect (clients must send it
#     as a Bearer token). Either one closes the global library.
# This is the difference between "only my PIN/viewer links are public" and "my whole library
# is public", so set it before exposing ImmichFrame to the internet.
# IMMICHFRAME_REQUIRE_SECRET=true

# AuthenticationSecret=
# Interval=10
# TransitionDuration=2
# ImageZoom=true
# ImagePan=false
# PlayAudio: false
# Layout=splitview
# DownloadImages=false
# ShowMemories=false
# ShowFavorites=false
# ShowArchived=false
# ShowVideos: false
# ImagesFromDays=
# ImagesFromDate=
# ImagesUntilDate=
# RenewImagesDuration=30
# Rating=5
# Albums=ALBUM1,ALBUM2
# ExcludedAlbums=ALBUM3,ALBUM4
# People=PERSON1,PERSON2
# Webcalendars=https://calendar.google.com/calendar/ical/XXXXXX/public/basic.ics,https://user:pass@calendar.immichframe.dev/dav/calendars/basic.ics
# RefreshAlbumPeopleInterval=12
# ShowClock=true
# ClockFormat=hh:mm
# ClockDateFormat=eee, MMM d
# ShowProgressBar=true
# ShowPhotoDate=true
# PhotoDateFormat=yyyy-MM-dd
# ShowImageDesc=true
# ShowPeopleDesc=true
# ShowAlbumName=true
# ShowImageLocation=true
# ImageLocationFormat=City,State,Country
# PrimaryColor=#F5DEB3
# SecondaryColor=#000000
# Style=none
# BaseFontSize=17px
# WeatherApiKey=
# ShowWeatherDescription=true
# WeatherIconUrl=https://openweathermap.org/img/wn/{IconId}.png
# UnitSystem=imperial
# WeatherLatLong=
# Language=en
# Webhook=
