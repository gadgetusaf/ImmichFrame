ImmichServerUrl=URL

# Either ApiKey or ApiKeyFile must be specified.
ApiKey=KEY
# ApiKeyFile=/path/to/key

# --- Configuration storage ---
# Configuration is stored in a SQLite database so it can be edited at runtime.
# By default the database is created inside the Config directory (/app/Config/immichframe.db);
# mount /app/Config to persist it. Override the location with IMMICHFRAME_DB_PATH.
# IMMICHFRAME_DB_PATH=/app/Config/immichframe.db
#
# On first start, the values below (or a Settings.json/Settings.yml) are imported into the
# database once. After that the database is authoritative and these values are ignored.
# To force a one-time re-import after editing this file, set IMMICHFRAME_REIMPORT=true for one boot.
# IMMICHFRAME_REIMPORT=false

# --- Admin UI ---
# Browse to /admin to manage configuration in your browser. On first run you can create the admin
# account directly in the UI, or bootstrap it here (only used while no admin account exists yet):
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
#
# Exposing ImmichFrame to the internet? Set ADMIN_USERNAME/ADMIN_PASSWORD before first start
# (so the public can't reach first-run setup) and put it behind a TLS reverse proxy.
# See docker/reverse-proxy.md for Caddy/Traefik/nginx examples and a hardening checklist.

# AuthenticationSecret=
# Interval=10
# TransitionDuration=2
# ImageZoom=true
# ImagePan=false
# PlayAudio: false
# Layout=splitview
# DownloadImages=false
# ShowMemories=false
# ShowFavorites=false
# ShowArchived=false
# ShowVideos: false
# ImagesFromDays=
# ImagesFromDate=
# ImagesUntilDate=
# RenewImagesDuration=30
# Rating=5
# Albums=ALBUM1,ALBUM2
# ExcludedAlbums=ALBUM3,ALBUM4
# People=PERSON1,PERSON2
# Webcalendars=https://calendar.google.com/calendar/ical/XXXXXX/public/basic.ics,https://user:pass@calendar.immichframe.dev/dav/calendars/basic.ics
# RefreshAlbumPeopleInterval=12
# ShowClock=true
# ClockFormat=hh:mm
# ClockDateFormat=eee, MMM d
# ShowProgressBar=true
# ShowPhotoDate=true
# PhotoDateFormat=yyyy-MM-dd
# ShowImageDesc=true
# ShowPeopleDesc=true
# ShowAlbumName=true
# ShowImageLocation=true
# ImageLocationFormat=City,State,Country
# PrimaryColor=#F5DEB3
# SecondaryColor=#000000
# Style=none
# BaseFontSize=17px
# WeatherApiKey=
# ShowWeatherDescription=true
# WeatherIconUrl=https://openweathermap.org/img/wn/{IconId}.png
# UnitSystem=imperial
# WeatherLatLong=
# Language=en
# Webhook=
